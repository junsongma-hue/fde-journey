# Copy this file to .env and fill in real values. .env is gitignored.

# =============================================================================
# LLM Provider — supports both Anthropic-native and OpenAI-compatible proxies
# =============================================================================
# Choose ONE of these styles. The script will auto-detect.

# ----- Style A: Direct Anthropic OR Anthropic-format proxy ------------------
# Leave LLM_BASE_URL empty for direct Anthropic API.
# Set it to your proxy if you use one (e.g. https://api.example.com).
# LLM_BASE_URL=
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-3-5-sonnet-latest
# LLM_PROTOCOL=anthropic

# ----- Style B: OpenAI-compatible proxy (most common in China) ---------------
# Many proxies (oneapi/newapi/openrouter etc.) expose a single OpenAI-format
# endpoint that can route to GPT, Claude, Gemini, etc. by model name.
LLM_BASE_URL=https://your-proxy-domain.com/v1
LLM_API_KEY=sk-your-proxy-key-here
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_PROTOCOL=openai

# =============================================================================
# Notes
# =============================================================================
# - LLM_PROTOCOL must be "anthropic" or "openai".
# - When unsure: most Chinese proxies = "openai" protocol.
# - If your proxy uses /v1/chat/completions endpoint → openai protocol.
# - If your proxy uses /v1/messages endpoint → anthropic protocol.
